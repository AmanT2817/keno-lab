// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")      // pooled connection (runtime)
  directUrl = env("DIRECT_URL")        // direct connection (migrations)
}

// A player holds the simulated balance. Balance is derived from
// the ledger (sum of credits minus debits) for reconciliation.
model Player {
  id           String         @id @default(cuid())
  name         String         @unique
  balanceMinor Int            @default(100000) // 1000.00 in minor units (cents)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  tickets      Ticket[]
  ledgerEntries LedgerEntry[]
}

// Lifecycle of a Keno round. The state machine is OPEN -> CLOSED -> DRAWN
// -> SETTLED -> ARCHIVED. Each scheduled round has four scheduled timestamps
// that drive the server-authoritative lifecycle:
//   - scheduledClosesAt   = opensAt + OPEN_DURATION_MS         (betting closes)
//   - scheduledDrawnAt    = scheduledClosesAt                   (draw begins)
//   - scheduledSettledAt  = scheduledDrawnAt + DRAW_DURATION_MS (reveal animation done)
//   - scheduledNextRoundAt= scheduledSettledAt + WAIT_DURATION_MS (next round opens)
//
// `advanceRoundsIfNeeded()` runs on every API request and lazily advances
// the current round through its phases based on the server clock. This
// keeps the round schedule authoritative — clients cannot speed it up,
// slow it down, or trigger duplicate draws.
model GameRound {
  id                    String       @id @default(cuid())
  roundNumber           Int?                          // sequential, for display (null for legacy rounds)
  status                String       // OPEN | CLOSED | DRAWN | SETTLED | ARCHIVED
  opensAt               DateTime     @default(now())
  closesAt              DateTime?
  drawnAt               DateTime?
  settledAt             DateTime?
  scheduledClosesAt     DateTime?    // null for legacy instant-play rounds
  scheduledDrawnAt      DateTime?
  scheduledSettledAt    DateTime?
  scheduledNextRoundAt  DateTime?
  nextRoundId           String?      // optional link to the successor round
  rulesVersion          String       @default("v1")
  tickets               Ticket[]
  drawResult            DrawResult?

  @@index([status])
  @@index([scheduledClosesAt])
}

// A submitted ticket. Selected numbers stored as JSON array string
// (SQLite does not have a native array type). Money is integer minor units.
model Ticket {
  id              String         @id @default(cuid())
  playerId        String
  roundId         String
  selectedNumbers String         // JSON-encoded number[]
  spots           Int
  stakeMinor      Int
  paytableVersion String
  status          String         // SUBMITTED | SETTLED
  idempotencyKey  String         @unique
  createdAt       DateTime       @default(now())
  player          Player         @relation(fields: [playerId], references: [id])
  round           GameRound      @relation(fields: [roundId], references: [id])
  ticketResult    TicketResult?
  ledgerEntries   LedgerEntry[]
}

// Immutable official draw for a round. One authoritative result per round.
model DrawResult {
  roundId          String   @unique
  winningNumbers   String   // JSON-encoded number[] (20 unique values)
  algorithmVersion String
  createdAt        DateTime @default(now())
  round            GameRound @relation(fields: [roundId], references: [id])
}

// Evaluated outcome for each ticket. At most one result per ticket.
model TicketResult {
  ticketId        String   @unique
  matchedNumbers  String   // JSON-encoded number[]
  matchCount      Int
  payoutMinor     Int
  isWin           Boolean
  createdAt       DateTime @default(now())
  ticket          Ticket   @relation(fields: [ticketId], references: [id])
}

// Append-only ledger of all money movements.
model LedgerEntry {
  id              String   @id @default(cuid())
  playerId        String
  ticketId        String?
  roundId         String?
  entryType       String   // STAKE_DEBIT | PAYOUT_CREDIT | REFUND_CREDIT | ADJUSTMENT
  amountMinor     Int      // positive number; sign conveyed by entryType
  idempotencyKey  String   @unique
  createdAt       DateTime @default(now())
  player          Player   @relation(fields: [playerId], references: [id])
  ticket          Ticket?  @relation(fields: [ticketId], references: [id])
}
